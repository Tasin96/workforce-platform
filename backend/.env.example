PORT=5000
NODE_ENV=development

# --- PostgreSQL connection ---
# Option A: single connection string (recommended, works with Render/Railway/Supabase/Neon/ElephantSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workforce_platform

# Option B: individual fields (used only if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=workforce_platform
PGUSER=postgres
PGPASSWORD=postgres

# Set to true if your provider requires SSL (most managed cloud Postgres does)
PG_SSL=false

JWT_SECRET=change_this_super_secret_key
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
